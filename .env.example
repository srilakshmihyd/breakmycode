NEBIUS_API_KEY="your-nebius-api-key"

# A single model works for every role. Optional role-specific IDs enable routing.
NEBIUS_MODEL="nvidia/Nemotron-3_5-Lightning"
NEBIUS_MODEL_FAST="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
NEBIUS_MODEL_STANDARD="nvidia/nemotron-3-super-120b-a12b"
NEBIUS_MODEL_REASONING="nvidia/Nemotron-3-Ultra-550b-a55b"

# Optional: change where scan history and traces are stored.
# BREAKMYCODE_DATA_DIR="/path/to/private/data"

# Optional pricing override: {"model-id":[input_USD_per_million,output_USD_per_million]}
# BREAKMYCODE_MODEL_PRICING_JSON='{}'

# Optional external LangGraph tracing (may transmit graph state/test output).
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="your-langsmith-key"
# LANGSMITH_PROJECT="breakmycode"
