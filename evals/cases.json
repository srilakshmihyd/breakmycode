    },
    {
      "name": "network-status-bug",
      "project": "fixtures/network_bug",
      "runs": 2,
      "expected_failing_tests": ["test_client.py::test_healthy_status"],
      "expected_classifications": {
        "test_client.py::test_healthy_status": "code_bug"
      }
    }
  ]
