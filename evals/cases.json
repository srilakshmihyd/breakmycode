        "test_items.py::test_empty_items": "code_bug"
      }
    },
    {
      "name": "random-seed-flake",
      "project": "fixtures/random_seed_flake",
      "runs": 20,
      "expected_flaky_tests": ["test_clock.py::test_unstable_clock"]
    },
    {
      "name": "concurrency-bug",
      "project": "fixtures/concurrency_bug",
      "runs": 2,
      "expected_failing_tests": ["test_counter.py::test_two_workers_increment"],
      "expected_classifications": {
        "test_counter.py::test_two_workers_increment": "code_bug"
